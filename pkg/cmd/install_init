#!/bin/bash
#
# 安装前回调。
#
# 关键约束：fnOS 在调用本脚本时，尚未创建 /var/apps/<appname> 的目录骨架，
# /vol1/@appdata、@apphome、@appconf 下的目标目录也还不存在；而本脚本以
# 应用包用户身份运行，无权在 root 拥有的 /vol1 下 mkdir。因此这里
# 绝不做任何目录创建或写文件动作，否则会以 "Permission denied" 失败，
# 并被应用中心显示为「无法创建应用目录」，导致整个安装中止。
#
# 目录骨架由安装器在 install_init 之后以 root 创建，业务初始化放在
# install_callback 里执行。
set -uo pipefail   # 故意不加 -e：安装前回调必须始终成功

exit 0
